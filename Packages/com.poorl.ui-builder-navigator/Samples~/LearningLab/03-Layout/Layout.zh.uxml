<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
        第 3 页提供可直接检查的父子布局样本。
        示例只陈述方向、尺寸、对齐和伸缩等布局事实，不把计算结果包装成自动诊断结论。
    -->
    <Style src="../Shared/Examples.uss" />
    <Style src="Layout.uss" />
    <ui:VisualElement name="layout-demo-root" class="demo-page">
        <ui:ScrollView name="layout-page-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="demo-page-scroll">
            <ui:VisualElement name="layout-content" class="demo-content">
                <ui:VisualElement name="layout-header" class="demo-header">
                    <ui:Label text="UI BUILDER NAVIGATOR · LEARNING LAB" class="demo-kicker" />
                    <ui:Label text="03 · 对照父容器与当前元素布局" class="demo-title" />
                    <ui:Label text="从画布范围和父子计算值理解方向、对齐、百分比尺寸与 Flex 伸缩。" class="demo-lead" />
                </ui:VisualElement>

                <ui:VisualElement name="layout-steps" class="demo-section">
                    <ui:VisualElement class="demo-section-header">
                        <ui:Label text="建议操作路径" class="demo-section-title" />
                        <ui:Label text="选择下列命名元素，让画布高亮父子范围，再在布局对照页读取实际计算值。" class="demo-section-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="demo-step-row">
                        <ui:VisualElement name="layout-step-select" class="demo-step">
                            <ui:Label text="步骤 01" class="demo-step-number" />
                            <ui:Label text="选择当前元素" class="demo-step-title" />
                            <ui:Label text="从 stretch、center、50% 或 flex 子元素中选择一个。" class="demo-step-copy" />
                        </ui:VisualElement>
                        <ui:VisualElement name="layout-step-highlight" class="demo-step">
                            <ui:Label text="步骤 02" class="demo-step-number" />
                            <ui:Label text="比较父子范围" class="demo-step-title" />
                            <ui:Label text="观察紫色父内容区和蓝色当前元素外框在画布中的实际范围。" class="demo-step-copy" />
                        </ui:VisualElement>
                        <ui:VisualElement name="layout-step-read" class="demo-step">
                            <ui:Label text="步骤 03" class="demo-step-number" />
                            <ui:Label text="读取布局事实" class="demo-step-title" />
                            <ui:Label text="核对方向、对齐、Grow、Shrink、Basis 与 min/max；不自动判断设计是否正确。" class="demo-step-copy" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="layout-directions" class="demo-section">
                    <ui:VisualElement class="demo-section-header">
                        <ui:Label text="横排与竖排" class="demo-section-title" />
                        <ui:Label text="子项完全相同，只改变父容器的 flex-direction。" class="demo-section-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="layout-grid">
                        <ui:VisualElement name="layout-row-panel" class="layout-panel">
                            <ui:Label text="Row" class="layout-panel-title" />
                            <ui:VisualElement name="layout-row-container" class="layout-row">
                                <ui:Label text="A" class="layout-chip" />
                                <ui:Label text="B" class="layout-chip" />
                                <ui:Label text="C" class="layout-chip" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="layout-column-panel" class="layout-panel">
                            <ui:Label text="Column" class="layout-panel-title" />
                            <ui:VisualElement name="layout-column-container" class="layout-column">
                                <ui:Label text="A" class="layout-chip" />
                                <ui:Label text="B" class="layout-chip" />
                                <ui:Label text="C" class="layout-chip" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="layout-alignment" class="demo-section">
                    <ui:VisualElement class="demo-section-header">
                        <ui:Label text="Stretch 与 Center" class="demo-section-title" />
                        <ui:Label text="两个父容器都是 Column；第二个只增加 align-items: center。" class="demo-section-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="layout-grid">
                        <ui:VisualElement name="layout-stretch-panel" class="layout-panel">
                            <ui:Label text="默认 Stretch" class="layout-panel-title" />
                            <ui:VisualElement name="layout-stretch-parent" class="layout-align-parent">
                                <ui:Button name="layout-stretch-button" text="横向拉伸" class="layout-stretch-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="layout-center-panel" class="layout-panel">
                            <ui:Label text="Center" class="layout-panel-title" />
                            <ui:VisualElement name="layout-center-parent" class="layout-align-parent layout-align-center">
                                <ui:Button name="layout-center-button" text="保持内容宽度" class="layout-center-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="layout-sizing" class="demo-section">
                    <ui:VisualElement class="demo-section-header">
                        <ui:Label text="50% 宽度与 Flex 伸缩" class="demo-section-title" />
                        <ui:Label text="选择命名子元素，对照父级宽度、Grow、Shrink、Basis 和 min/max。" class="demo-section-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="layout-grid">
                        <ui:VisualElement name="layout-percent-panel" class="layout-panel">
                            <ui:Label text="父级宽度的 50%" class="layout-panel-title" />
                            <ui:VisualElement name="layout-percent-track" class="layout-percent-track">
                                <ui:VisualElement name="layout-percent-child" class="layout-percent-child">
                                    <ui:Label text="width: 50%" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="layout-flex-panel" class="layout-panel">
                            <ui:Label text="Grow / Shrink / Min-Max" class="layout-panel-title" />
                            <ui:VisualElement name="layout-flex-row" class="layout-flex-row">
                                <ui:VisualElement name="layout-fixed-child" class="layout-fixed-child"><ui:Label text="固定 92px" /></ui:VisualElement>
                                <ui:VisualElement name="layout-flex-child" class="layout-flex-child"><ui:Label text="Grow 1 · Shrink 1" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="layout-minmax-child" class="layout-minmax-child"><ui:Label text="min 120 · max 240" /></ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="layout-scroll-section" class="demo-section">
                    <ui:VisualElement class="demo-section-header">
                        <ui:Label text="ScrollView 的实际布局父级" class="demo-section-title" />
                        <ui:Label text="Hierarchy 中可见 ScrollView 自动生成的 viewport 与 content container；内容项实际由 content container 排列。" class="demo-section-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement name="layout-scroll-shell" class="layout-scroll-shell">
                        <ui:Label text="展开 #layout-scroll 后选择任一内容项，对照其直接布局父级。" class="layout-panel-copy" />
                        <ui:ScrollView name="layout-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="layout-scroll">
                            <ui:Label text="内容项 01 · 检查父级外框" class="layout-scroll-item" />
                            <ui:Label text="内容项 02 · 检查内容宽度" class="layout-scroll-item" />
                            <ui:Label text="内容项 03 · 检查排列方向" class="layout-scroll-item" />
                            <ui:Label text="内容项 04 · 检查滚动范围" class="layout-scroll-item" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label text="本页的结论边界：插件呈现 Unity 已计算出的布局事实与父子范围，不自动判断造成该结果的设计原因。" class="layout-fact-note" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
